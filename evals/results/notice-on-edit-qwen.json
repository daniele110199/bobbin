            "content": "def apply_discount(amount, percent):\n    \"\"\"\n    Apply a discount to an amount.\n    \n    Args:\n        amount (float): The original amount\n        percent (float): The discount percentage to subtract\n        \n    Returns:\n        float: The amount after subtracting the discount\n    \"\"\"\n    return amount - (amount * percent / 100)"
          }
